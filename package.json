{
  "name": "fluxometer",
  "version": "0.1.0",
  "description": "Zero-cost performance & bottleneck observability for JS/TS + Postgres apps — daily Slack summary and a local MCP server, no dashboard, no paid infra.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fluxometer": "./dist/cli/bin.js"
  },
  "main": "./dist/adapters/generic.js",
  "types": "./dist/adapters/generic.d.ts",
  "exports": {
    ".": "./dist/adapters/generic.js",
    "./express": "./dist/adapters/express.js",
    "./fastify": "./dist/adapters/fastify.js",
    "./next": "./dist/adapters/next.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.11.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "*",
    "fastify": "*",
    "next": "*"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  }
}

{
  "name": "fluxometer",
  "version": "0.2.0",
  "description": "Zero-cost performance & bottleneck observability for JS/TS + Postgres apps — daily Slack summary and a local MCP server, no dashboard, no paid infra.",
  "license": "MIT",
  "author": "Allan Monteiro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allanaramont/fluxometer.git"
  },
  "homepage": "https://github.com/allanaramont/fluxometer#readme",
  "bugs": {
    "url": "https://github.com/allanaramont/fluxometer/issues"
  },
  "keywords": [
    "observability",
    "postgres",
    "performance",
    "monitoring",
    "slack",
    "mcp",
    "express",
    "fastify",
    "next"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fluxometer": "./dist/cli/bin.js"
  },
  "main": "./dist/adapters/generic.js",
  "types": "./dist/adapters/generic.d.ts",
  "exports": {
    ".": "./dist/adapters/generic.js",
    "./express": "./dist/adapters/express.js",
    "./fastify": "./dist/adapters/fastify.js",
    "./next": "./dist/adapters/next.js",
    "./report": "./dist/report/route.js",
    "./migrate": "./dist/migrate.js",
    "./package.json": "./package.json"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.11.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "*",
    "fastify": "*",
    "next": "*"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}

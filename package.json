{
  "name": "fluxometer",
  "version": "0.1.0",
  "description": "Zero-cost performance & bottleneck observability for JS/TS + Postgres apps — daily Slack summary and a local MCP server, no dashboard, no paid infra.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.1",
    "pg": "^8.11.5"
  },
  "peerDependencies": {
    "express": "*",
    "fastify": "*",
    "next": "*"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  }
}
